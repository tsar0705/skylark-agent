# Monday.com
MONDAY_API_KEY=your_monday_api_key_here
MONDAY_WORK_ORDERS_BOARD_ID=123456789
MONDAY_DEALS_BOARD_ID=123456790

# Anthropic (the agent's reasoning + conversation engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cache TTL for monday.com data pulls, in seconds (avoids hammering the API on every chat turn)
DATA_CACHE_TTL_SECONDS=120

# CORS - comma separated list of allowed origins for the hosted frontend
ALLOWED_ORIGINS=*
